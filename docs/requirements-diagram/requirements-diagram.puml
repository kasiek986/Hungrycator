@startuml
skinparam wrapWidth 250
skinparam ComponentStyle uml2
left to right direction

package "Wymagania Funkcjonalne (ISO/IEC 25002)" {
  
  class "FR-01: Rejestracja produktów w lodówce" as FR01 <<requirement>> {
    id = "FR-01"
    text = "System umożliwia dodawanie, zmianę ilości i terminów ważności produktów."
  }

  class "FR-02: Proponowanie posiłków i głosowanie" as FR02 <<requirement>> {
    id = "FR-02"
    text = "System umożliwia zgłaszanie propozycji i głosowanie przez domowników."
  }

  class "FR-03: Zarządzanie przepisami" as FR03 <<requirement>> {
    id = "FR-03"
    text = "System umożliwia przeglądanie i dodawanie własnych przepisów."
  }

  class "FR-04: Generowanie listy zakupów" as FR04 <<requirement>> {
    id = "FR-04"
    text = "System umożliwia automatyczne dodawanie brakujących składników."
  }

  class "FR-05: Zarządzanie domownikami" as FR05 <<requirement>> {
    id = "FR-05"
    text = "System umożliwia dołączanie do gospodarstwa za pomocą kodu zaproszenia."
  }
}

package "Wymagania Niefunkcjonalne (NFR)" {

  class "NFR-01: Wydajność" as NFR01 <<requirement>> {
    id = "NFR-01"
    text = "95% pomiarów ładowania listy produktów trwa maksymalnie 2 s."
  }

  class "NFR-02: Dostępność" as NFR02 <<requirement>> {
    id = "NFR-02"
    text = "Dostępność systemu (Availability) wynosi co najmniej 99% w miesiącu."
  }

  class "NFR-03: Bezpieczeństwo" as NFR03 <<requirement>> {
    id = "NFR-03"
    text = "100% prób nieuprawnionego dostępu kończy się odmową."
  }

  class "NFR-04: Synchronizacja danych" as NFR04 <<requirement>> {
    id = "NFR-04"
    text = "95% zmian jest widocznych u drugiego domownika w ciągu 3 s."
  }

  class "NFR-05: Odtwarzanie po awarii" as NFR05 <<requirement>> {
    id = "NFR-05"
    text = "Średni czas naprawy (MTTR) nie przekracza 30 minut."
  }
}

' Poprawne relacje śledzenia (trace) zamiast błędnego refine
NFR01 ..> FR01 : <<trace>>
NFR01 ..> FR04 : <<trace>>
NFR02 ..> FR01 : <<trace>>
NFR02 ..> FR02 : <<trace>>
NFR03 ..> FR05 : <<trace>>
NFR04 ..> FR01 : <<trace>>
NFR04 ..> FR02 : <<trace>>
NFR05 ..> FR01 : <<trace>>

@enduml