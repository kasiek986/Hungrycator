plantuml
@startuml
title Hungrycator - SysML Requirements Diagram

left to right direction
skinparam shadowing false

package "Wymagania funkcjonalne" {

  requirement "Zarzadzanie lodowka" as FR01 {
    id = "FR-01"
    text = "System umozliwia dodawanie i zmiane produktow, ilosci oraz terminow waznosci."
  }

  requirement "Proponowanie posilkow" as FR02 {
    id = "FR-02"
    text = "System umozliwia proponowanie posilkow i zapisywanie glosow domownikow."
  }

  requirement "Baza przepisow" as FR03 {
    id = "FR-03"
    text = "System umozliwia przegladanie i dodawanie przepisow."
  }

  requirement "Lista zakupow" as FR04 {
    id = "FR-04"
    text = "System umozliwia tworzenie listy zakupow z brakujacych skladnikow."
  }

  requirement "Zarzadzanie domownikami" as FR05 {
    id = "FR-05"
    text = "System umozliwia dolaczanie do gospodarstwa za pomoca kodu zaproszenia."
  }
}

package "Wymagania niefunkcjonalne" {

  requirement "Wydajnosc" as NFR01 {
    id = "NFR-01"
    text = "95% pomiarow ladowania listy produktow trwa maksymalnie 2 s."
  }

  requirement "Dostepnosc" as NFR02 {
    id = "NFR-02"
    text = "Dostepnosc systemu wynosi co najmniej 99% w miesiacu."
  }

  requirement "Bezpieczenstwo" as NFR03 {
    id = "NFR-03"
    text = "100% testow nieuprawnionego dostepu do danych konczy sie odmowa."
  }

  requirement "Synchronizacja danych" as NFR04 {
    id = "NFR-04"
    text = "95% zmian jest widocznych u drugiego domownika w ciagu 3 s."
  }

  requirement "Odtwarzanie po awarii" as NFR05 {
    id = "NFR-05"
    text = "Sredni czas od zgloszenia awarii do przywrocenia dzialania systemu (MTTR) nie przekracza 30 min, mierzony w testach odtwarzania."
  }
}

FR01 ..> NFR01 : «refine»
FR01 ..> NFR03 : «refine»
FR04 ..> NFR04 : «refine»
FR02 ..> NFR04 : «refine»
FR04 ..> NFR03 : «refine»
FR05 ..> NFR03 : «refine»
FR01 ..> NFR02 : «refine»

@enduml
