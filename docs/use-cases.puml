@startuml
title Hungrycator - Diagram przypadków użycia UML 

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho

actor "Domownik" as D
actor "Administrator\n gospodarstwa domowego" as A
actor "Nowy domownik" as N

rectangle "System Hungrycator" {
  usecase "UC-01\nZarządzanie produktami\nw wirtualnej lodówce" as UC01
  usecase "UC-02\nProponowanie posiłków\ni głosowanie" as UC02
  usecase "UC-03\nPrzeglądanie i dodawanie\nprzepisów" as UC03
  usecase "UC-04\nTworzenie listy zakupów\nz brakujących składników" as UC04
  usecase "UC-05\nZarządzanie gospodarstwem\ni zapraszanie domownikow" as UC05
}

' Aktorzy i główne przypadki użycia
D -- UC01
D -- UC02
D -- UC03
D -- UC04

A -- UC05
N -- UC05

note bottom of UC01
  FR-01 / S-01
end note

note bottom of UC02
  FR-02 / S-02
end note

note bottom of UC03
  FR-03 / S-03
end note

note bottom of UC04
  FR-04 / S-04
end note

note bottom of UC05
  FR-05 / S-05
end note

@enduml